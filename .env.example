# Copy this file to .env and replace the values with your local PostgreSQL settings.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team_bici
DB_USERNAME=postgres
DB_PASSWORD=

# Use update during local development. Use validate in production.
JPA_DDL_AUTO=update
SERVER_PORT=8080

# Use a randomly generated value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=14
TOKEN_CLEANUP_CRON=0 0 3 * * *

# Set these only once to bootstrap the first administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Enable this profile only after configuring the Google Cloud OAuth client values.
SPRING_PROFILES_ACTIVE=oauth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/auth/google/callback
MOBILE_OAUTH_SUCCESS_URL=teambici://auth/google/callback
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=60

# Comma-separated web origins allowed to call the API.
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
